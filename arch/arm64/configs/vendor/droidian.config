# Droidian/Halium kernel configuration fragment for SM8550 (kalama)
# Applied on top of: gki_defconfig + vendor/kalama_GKI.config +
#                    vendor/oplus/kalama_GKI.config + vendor/debugfs.config

# ---------------------------------------------------------------------------
# Namespaces — gki_defconfig has NAMESPACES=y but disables most sub-types
# ---------------------------------------------------------------------------
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# ---------------------------------------------------------------------------
# Cgroups — CGROUP_DEVICE needed by Android HW compat (libhybris) inside LXC
# ---------------------------------------------------------------------------
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PERF=y
CONFIG_BLK_CGROUP=y

# ---------------------------------------------------------------------------
# devtmpfs — systemd cannot populate /dev without this
# ---------------------------------------------------------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ---------------------------------------------------------------------------
# Security — AppArmor alongside SELinux for Droidian userspace
# ---------------------------------------------------------------------------
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
CONFIG_DEFAULT_SECURITY_APPARMOR=y
# Keep SELinux enabled; both LSMs coexist via CONFIG_LSM ordering
CONFIG_LSM="lockdown,yama,loadpin,safesetid,selinux,apparmor,bpf"

# ---------------------------------------------------------------------------
# Filesystems
# ---------------------------------------------------------------------------
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_FUSE_FS=y

# ---------------------------------------------------------------------------
# Display — fbdev emulation lets Droidian splash/recovery use /dev/fb0
# ---------------------------------------------------------------------------
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ---------------------------------------------------------------------------
# Networking — container and USB-tethering support
# ---------------------------------------------------------------------------
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# ---------------------------------------------------------------------------
# Crypto / Keys — systemd credential and keyring support
# ---------------------------------------------------------------------------
CONFIG_KEYS=y
CONFIG_ENCRYPTED_KEYS=m
CONFIG_TRUSTED_KEYS=m

# ---------------------------------------------------------------------------
# pstore / ramoops — persistent crash log capture
# (gki_defconfig already enables PSTORE/PSTORE_RAM/PSTORE_CONSOLE/PSTORE_PMSG
#  but we keep them here explicitly for the droidian fragment to be standalone)
# ---------------------------------------------------------------------------
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_FTRACE=n

# ---------------------------------------------------------------------------
# Misc — needed by Droidian init / udev / systemd
# ---------------------------------------------------------------------------
CONFIG_UNIX98_PTYS=y
CONFIG_LEGACY_PTYS=n
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_EPOLL=y
CONFIG_POSIX_MQUEUE=y
