#!/usr/bin/make -f
include /usr/share/linux-packaging-snippets/kernel-snippet.mk

%:
	dh $@

# Run prepare before the parallel Image build so that arch include
# symlinks and output subdirectories exist. Without this, -j16 races
# against the directory creation and fails with missing asm headers.
execute_before_dh_auto_build:
	$(BUILD_COMMAND) prepare

# The droidian-branch snippet has no plain out/kernel-stamp target (only
# out/kernel-stamp.default and out/kernel-stamp.%). Something in the build
# chain requests the unsuffixed form; alias it so the wildcard %: dh $@
# doesn't catch it.
out/kernel-stamp: out/kernel-stamp.default
	@true

# Boot header v4: ramdisk_size must be 0 (ramdisk lives in init_boot.img).
# The droidian snippet's explicit rules for initramfs.gz and recovery-initramfs.gz
# try to copy from halium-generic-initramfs (not installed). Override them with
# explicit rules (recipe required — pattern rules lose to explicit rules in make).
# These overrides fire AFTER the include because they appear later in the file.
out/KERNEL_OBJ/initramfs.gz:
	mkdir -p out/KERNEL_OBJ
	touch $@

out/KERNEL_OBJ/recovery-initramfs.gz:
	mkdir -p out/KERNEL_OBJ
	touch $@

# Pattern rule covers initramfs.default, initramfs.recovery-default, etc.
out/KERNEL_OBJ/initramfs.%:
	mkdir -p out/KERNEL_OBJ
	touch $@
